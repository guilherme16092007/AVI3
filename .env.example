DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/greencode?schema=public"
PORT=3000
HOST=127.0.0.1

JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-mais-de-32-caracteres
JWT_EXPIRES_IN=30m

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# ---------------- AV3: worker, analises agendadas e API publica ----------------
# Worker de relatorios embutido no processo da API (false = rodar so a API e usar `npm run start:worker` em outro processo)
WORKER_HABILITADO=true
WORKER_CONCORRENCIA=2
WORKER_INTERVALO_MS=2000
# Politica de retry: tentativas maximas por tarefa, base do backoff exponencial (5s, 10s, 20s...) e validade do lease
JOBS_MAX_TENTATIVAS=3
JOBS_BACKOFF_BASE_MS=5000
JOBS_LEASE_MS=300000
# Relatorios assincronos simultaneos permitidos por chave de API
JOBS_LIMITE_ATIVAS_POR_CHAVE=5
# Analises recorrentes (cron de 5 campos, fuso do servidor). Vazio desliga. Padrao: todo dia as 02:00
ANALISE_CRON=0 2 * * *
# Limites da API publica: requisicoes/min de novas chaves (padrao) e tentativas invalidas/min por IP
API_LIMITE_PADRAO_POR_MINUTO=60
API_LIMITE_IP_POR_MINUTO=30
